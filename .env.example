# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=MY_GEMINI_API_KEY
# GEMINI_MODEL: 'auto' routes across all free-tier models (gemini-4-hydrogen, gemini-3.1-flash-lite)
# with automatic fallback, or pin a specific free-tier model name.
GEMINI_MODEL=auto
